# URL base de la API que usa el frontend (axios `baseURL`).
#
# - Local:   el backend corre en http://localhost:3000
# - Vercel:  configura la variable VITE_API_URL en el proyecto (Settings →
#            Environment Variables) con https://esfotroutes.onrender.com/api
#            y haz un redeploy; si no está definida, el build apunta a
#            http://localhost:3000/api y TODO el frontend deja de funcionar.
#
# Vite solo expone las variables que empiezan con VITE_ y las inyecta en el
# bundle en tiempo de build (no en runtime).
VITE_API_URL=http://localhost:3000/api
