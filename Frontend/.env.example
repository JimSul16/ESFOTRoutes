# URL base de la API del backend (incluye el sufijo /api).
#
# IMPORTANTE: Vite incrusta esta variable EN TIEMPO DE COMPILACIÓN.
# Si la cambias en Vercel hay que volver a desplegar el frontend.
#
# Desarrollo local:
VITE_API_URL=http://localhost:3000/api
#
# Producción (ejemplo):
# VITE_API_URL=https://esfot-backend.onrender.com/api
