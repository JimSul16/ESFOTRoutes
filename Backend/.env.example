# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno del backend.
# Copiar a `.env` (desarrollo local) o configurar directamente en el hosting.
# NUNCA subir el `.env` real al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# Puerto HTTP. En Render/Railway NO lo definas: la plataforma lo inyecta.
PORT=3000
NODE_ENV=development

# Límite global de peticiones por IP cada 15 minutos.
# 300 es un valor razonable en producción; 100 (el antiguo) bloquea a alumnos
# que salen a Internet con la misma IP pública del campus.
RATE_LIMIT_MAX=300

# ── Base de Datos Turso (SQLite Cloud) ───────────────────────────────────────
# En LOCAL se puede usar el archivo: file:./dev.db
# En PRODUCCIÓN es OBLIGATORIO usar la nube: el disco del hosting es efímero
# y `file:./dev.db` se borra en cada deploy (la BD arrancaría sin usuarios).
TURSO_DATABASE_URL=libsql://your-db-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token
# TURSO_DATABASE_URL=file:./dev.db
# TURSO_AUTH_TOKEN=

# ── Motor de Grafos Neo4j AuraDB ─────────────────────────────────────────────
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# ── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Seguridad y Sesión ───────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h

# ── Correo Electrónico (Nodemailer / HTTPS API) ──────────────────────────────
# En LOCAL: se puede usar SMTP de Gmail (puerto 465).
# En PRODUCCIÓN (Render): los puertos SMTP están bloqueados.
# DEBES usar un proveedor HTTPS REST (puerto 443).
#
# Opción 0: Google Apps Script Webhook (Envío directo desde Gmail vía HTTPS sin SMS ni DNS)
MAIL_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec

# Opción A (Recomendada): Brevo (Sendinblue) - 300 correos/día GRATIS
# NO requiere poseer el dominio DNS @epn.edu.ec; basta con validar tu correo remitente.
# Obtener API key en: brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=your_email@gmail.com
BREVO_SENDER_NAME="Plataforma ESFOT"

# Opción B: Resend - 100 correos/día GRATIS
# NOTA: En modo sandbox (onboarding@resend.dev) SOLO envía a tu propio correo.
# Para enviar a @epn.edu.ec exige verificar un dominio propio en resend.com.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="Plataforma ESFOT <onboarding@resend.dev>"

# Opción C: SendGrid (Single Sender Verification)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=your_email@gmail.com
SENDGRID_FROM_NAME="Plataforma ESFOT"

# Fallback SMTP local (Gmail)
SMTP_SERVICE=gmail
SMTP_USER=your_email@epn.edu.ec
SMTP_PASS=your_app_password

# ── Frontend URL (CORS) ──────────────────────────────────────────────────────
# Origen EXACTO del frontend. Admite varias URLs separadas por coma.
# Desarrollo:  http://localhost:5173
# Producción:  https://tu-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# ── Google AI Studio (Gemini AI Cascade) ─────────────────────────────────────
GEMINI_API_KEY=your_primary_gemini_api_key
GEMINI_PRIMARY_MODEL=gemini-3.5-flash
GEMINI_BACKUP_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY_BACKUP=

# ── JDoodle Compiler API ─────────────────────────────────────────────────────
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
