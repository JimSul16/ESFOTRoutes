PORT=3000

# ── Turso (BD Relacional) ──────────────────────────────────────────────────────
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# ── Neo4j AuraDB (Grafo de Conocimiento) ───────────────────────────────────────
NEO4J_URI="neo4j+s://your-instance.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your-neo4j-password"
NEO4J_DATABASE="neo4j"

# ── Cloudinary (Imágenes / PDFs / Archivos) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Seguridad ──────────────────────────────────────────────────────────────────
JWT_SECRET="your-jwt-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="24h"

# ── Integraciones ─────────────────────────────────────────────────────────────
# ── Correo Electrónico (Nodemailer vía SMTP) ──────────────────────────────────
SMTP_SERVICE="gmail"
SMTP_USER="tucorreo@epn.edu.ec"
SMTP_PASS="tu-app-password"
FRONTEND_URL="http://localhost:5173"

# Google AI Studio: aistudio.google.com
GEMINI_API_KEY="your-gemini-api-key"

# JDoodle: jdoodle.com/compiler-api
JDOODLE_CLIENT_ID=""
JDOODLE_CLIENT_SECRET=""

# ── Admin Inicial (Opcional) ──────────────────────────────────────────────────
FIRST_ADMIN_EMAIL=""
FIRST_ADMIN_PASSWORD=""
